# ============================================
# 🔑 AZTLÁN DECODE - CONFIGURACIÓN DE API KEYS
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env" (sin el .example)
# 2. Llena tus API keys reales
# 3. Nunca compartas este archivo en GitHub
#
# ============================================

# ============================================
# FIRST API (FTC/FRC Oficial)
# ============================================
# Obtén tu API key en:
# https://frc-events.firstinspires.org/services/API
# 
# Necesitas registrarte y solicitar acceso
FIRST_API_USERNAME=tu_username_aqui
FIRST_API_KEY=tu_key_aqui

# ============================================
# THE ORANGE ALLIANCE (TOA)
# ============================================
# Obtén tu API key en:
# https://theorangealliance.org/apidocs
# 
# Solicita una key en su Discord o página oficial
TOA_API_KEY=tu_toa_key_aqui

# ============================================
# FTC SCOUT (GraphQL)
# ============================================
# No requiere API key - Es público y gratuito
# URL: https://api.ftcscout.org/graphql
# Esta API está siempre disponible

# ============================================
# GROQ API (Para Chatbot IA)
# ============================================
# Obtén tu API key GRATIS en:
# https://console.groq.com/
# 
# Groq ofrece acceso gratuito a modelos LLaMA
GROQ_API_KEY=tu_groq_key_aqui

# ============================================
# FLASK SECRET KEY
# ============================================
# Genera una clave secura aleatoria
# Puedes usar: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=tu_secret_key_aqui

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# 🔹 FTC Scout NO requiere API key - siempre funcionará
# 🔹 TOA API key es opcional - fallback a datos de respaldo
# 🔹 FIRST API es opcional - requiere autorización especial
# 🔹 GROQ es gratuito - necesario solo para el chatbot
#
# El sistema TRIDENTE funciona con degradación elegante:
# - Si todas las APIs están disponibles: PLATINUM (máxima confianza)
# - Si 2 APIs funcionan: GOLD (alta confianza)
# - Si 1 API funciona: SILVER (confianza básica)
# - Si ninguna funciona: Datos de respaldo simulados
#
# ============================================
