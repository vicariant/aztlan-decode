  "samples_trained": 5000,
  "description": "Modelo básico para clasificación de exoplanetas basado en datos de Kepler/TESS",
  "preprocessing": {
    "scaler": "StandardScaler",
    "missing_strategy": "mean"
  },
  "notes": "Modelo preliminar - Requiere entrenamiento con datos reales ejecutando train_model.py"
}
